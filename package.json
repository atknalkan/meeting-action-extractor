{
  "name": "meeting-action-extractor",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent that turns a meeting transcript into action items (task, owner, due date, priority), decisions and a summary. Paid per transcript in USDC on Stellar.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --disable-warning=ExperimentalWarning 'dist-test/test/**/*.test.js'",
    "dev": "tsc && provider-kit dev -- node --disable-warning=ExperimentalWarning dist/server.js",
    "try": "provider-kit try meeting-actions --start \"npm run dev\"",
    "check": "provider-kit check --manifest http://localhost:8787/.well-known/stellar-agent-services.json --dev",
    "verify": "verifier check http://localhost:8787/.well-known/stellar-agent-services.json --dev",
    "status": "provider-kit status",
    "launch": "tsc && provider-kit launch --start \"node --disable-warning=ExperimentalWarning dist/server.js\"",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server.js",
    "extract": "tsc && node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/cli.js",
    "deploy": "bash deploy/oracle/deploy.sh"
  },
  "dependencies": {
    "@stellar-agent-services/payment-client": "file:vendor/stellar-agent-services-payment-client-0.1.1.tgz",
    "@stellar-agent-services/protocol": "file:vendor/stellar-agent-services-protocol-0.1.1.tgz",
    "@stellar-agent-services/provider-kit": "file:vendor/stellar-agent-services-provider-kit-0.1.1.tgz"
  },
  "devDependencies": {
    "@stellar-agent-services/verifier": "file:vendor/stellar-agent-services-verifier-0.1.1.tgz",
    "@stellar/stellar-sdk": "16.4.1",
    "@types/node": "22.20.5",
    "@x402/core": "2.28.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@trionlabs/stellar8004": {
      "@stellar/stellar-sdk": "16.4.1"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atknalkan/meeting-action-extractor.git"
  },
  "homepage": "https://github.com/atknalkan/meeting-action-extractor"
}
